{"markdown":{"yaml":{"title":"","format":{"html":{"theme":"none","css":"styles.css","toc":false,"title-block-banner":false,"include-in-header":{"text":"<meta name=\"description\" content=\"Ainhoa Vega-Bayo — Profesora Agregada de Economía, UPV/EHU\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"icon\" type=\"image/x-icon\" href=\"assets/favicon.ico\">\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"assets/favicon.svg\">\n<link rel=\"apple-touch-icon\" href=\"assets/favicon-48.png\">\n"}}}},"containsRefs":false,"markdown":"\n\n```{r setup, include=FALSE}\nsource(\"R/cv_helpers.R\")\ncv <- load_cv(\"_cv_data.yml\")\n```\n\n```{=html}\n<nav class=\"lang-bar\">\n  <span class=\"site-name\">Ainhoa Vega-Bayo · Curriculum Vitae</span>\n  <div class=\"lang-btns\">\n    <button class=\"lang-btn active\" onclick=\"setLang('en')\" id=\"btn-en\">EN</button>\n    <button class=\"lang-btn\"        onclick=\"setLang('eu')\" id=\"btn-eu\">EU</button>\n    <button class=\"lang-btn\"        onclick=\"setLang('es')\" id=\"btn-es\">ES</button>\n  </div>\n</nav>\n\n<div class=\"page-wrap\">\n<aside class=\"sidebar\">\n```\n\n```{r sidebar-dynamic}\n#| echo: false\nrender_sidebar_dynamic(cv)\n```\n\n```{=html}\n<hr class=\"sidebar-divider\">\n<div class=\"sidebar-section\">\n  <span class=\"sidebar-label lang-block active\" id=\"sl-int-eu\">Ikerketa arloak</span>\n  <span class=\"sidebar-label lang-block\"        id=\"sl-int-en\">Research areas</span>\n  <span class=\"sidebar-label lang-block\"        id=\"sl-int-es\">Áreas de investigación</span>\n  <div class=\"tag-list\">\n    <span class=\"tag\">Program Evaluation</span>\n    <span class=\"tag\">Discrete Choice</span>\n    <span class=\"tag\">School Choice</span>\n    <span class=\"tag\">Labour Economics</span>\n    <span class=\"tag\">Gender &amp; Inequality</span>\n    <span class=\"tag\">R / Econometrics</span>\n    <span class=\"tag\">Education Policy</span>\n  </div>\n</div>\n<hr class=\"sidebar-divider\">\n<div class=\"sidebar-section\">\n  <span class=\"sidebar-label\">Hizkuntzak / Languages</span>\n  <div class=\"skill-item\" style=\"margin-bottom:0.25rem\">Euskara <span class=\"skill-dots\">●●●●●</span></div>\n  <div class=\"skill-item\" style=\"margin-bottom:0.25rem\">Español <span class=\"skill-dots\">●●●●●</span></div>\n  <div class=\"skill-item\" style=\"margin-bottom:0.25rem\">English <span class=\"skill-dots\">●●●●●</span></div>\n  <div class=\"skill-item\">Français <span class=\"skill-dots\">●●○○○</span></div>\n</div>\n<hr class=\"sidebar-divider\">\n<div class=\"sidebar-section\">\n  <span class=\"sidebar-label\">Software</span>\n  <div class=\"tag-list\">\n    <span class=\"tag\">R</span><span class=\"tag\">Quarto</span><span class=\"tag\">Shiny</span>\n    <span class=\"tag\">Plotly</span><span class=\"tag\">QGIS</span>\n  </div>\n</div>\n\n</aside>\n\n<main class=\"main-content\">\n```\n\n```{r block-eu}\n#| echo: false\nrender_lang_block(cv, \"eu\", active = TRUE)\n```\n\n```{r block-en}\n#| echo: false\nrender_lang_block(cv, \"en\")\n```\n\n```{r block-es}\n#| echo: false\nrender_lang_block(cv, \"es\")\n```\n\n```{=html}\n<footer class=\"site-footer\">\n  <span>© 2026 Ainhoa Vega-Bayo · UPV/EHU</span>\n  <span>Built with Quarto &amp; R · GitHub Pages</span>\n</footer>\n</main>\n</div>\n\n<script>\nconst LANGS = ['eu', 'en', 'es'];\nfunction setLang(lang) {\n  LANGS.forEach(l => {\n    document.getElementById('block-' + l)?.classList.toggle('active', l === lang);\n    document.getElementById('sidebar-' + l)?.classList.toggle('active', l === lang);\n    document.getElementById('sl-int-' + l)?.classList.toggle('active', l === lang);\n    document.getElementById('btn-' + l)?.classList.toggle('active', l === lang);\n  });\n  localStorage.setItem('cv-lang', lang);\n}\n(function() {\n  const saved = localStorage.getItem('cv-lang');\n  if (saved && LANGS.includes(saved)) { setLang(saved); return; }\n  const nav = (navigator.language || '').toLowerCase();\n  if (nav.startsWith('eu')) setLang('eu');\n  else if (nav.startsWith('es')) setLang('es');\n  else setLang('eu');\n})();\n</script>\n```\n","srcMarkdownNoYaml":"\n\n```{r setup, include=FALSE}\nsource(\"R/cv_helpers.R\")\ncv <- load_cv(\"_cv_data.yml\")\n```\n\n```{=html}\n<nav class=\"lang-bar\">\n  <span class=\"site-name\">Ainhoa Vega-Bayo · Curriculum Vitae</span>\n  <div class=\"lang-btns\">\n    <button class=\"lang-btn active\" onclick=\"setLang('en')\" id=\"btn-en\">EN</button>\n    <button class=\"lang-btn\"        onclick=\"setLang('eu')\" id=\"btn-eu\">EU</button>\n    <button class=\"lang-btn\"        onclick=\"setLang('es')\" id=\"btn-es\">ES</button>\n  </div>\n</nav>\n\n<div class=\"page-wrap\">\n<aside class=\"sidebar\">\n```\n\n```{r sidebar-dynamic}\n#| echo: false\nrender_sidebar_dynamic(cv)\n```\n\n```{=html}\n<hr class=\"sidebar-divider\">\n<div class=\"sidebar-section\">\n  <span class=\"sidebar-label lang-block active\" id=\"sl-int-eu\">Ikerketa arloak</span>\n  <span class=\"sidebar-label lang-block\"        id=\"sl-int-en\">Research areas</span>\n  <span class=\"sidebar-label lang-block\"        id=\"sl-int-es\">Áreas de investigación</span>\n  <div class=\"tag-list\">\n    <span class=\"tag\">Program Evaluation</span>\n    <span class=\"tag\">Discrete Choice</span>\n    <span class=\"tag\">School Choice</span>\n    <span class=\"tag\">Labour Economics</span>\n    <span class=\"tag\">Gender &amp; Inequality</span>\n    <span class=\"tag\">R / Econometrics</span>\n    <span class=\"tag\">Education Policy</span>\n  </div>\n</div>\n<hr class=\"sidebar-divider\">\n<div class=\"sidebar-section\">\n  <span class=\"sidebar-label\">Hizkuntzak / Languages</span>\n  <div class=\"skill-item\" style=\"margin-bottom:0.25rem\">Euskara <span class=\"skill-dots\">●●●●●</span></div>\n  <div class=\"skill-item\" style=\"margin-bottom:0.25rem\">Español <span class=\"skill-dots\">●●●●●</span></div>\n  <div class=\"skill-item\" style=\"margin-bottom:0.25rem\">English <span class=\"skill-dots\">●●●●●</span></div>\n  <div class=\"skill-item\">Français <span class=\"skill-dots\">●●○○○</span></div>\n</div>\n<hr class=\"sidebar-divider\">\n<div class=\"sidebar-section\">\n  <span class=\"sidebar-label\">Software</span>\n  <div class=\"tag-list\">\n    <span class=\"tag\">R</span><span class=\"tag\">Quarto</span><span class=\"tag\">Shiny</span>\n    <span class=\"tag\">Plotly</span><span class=\"tag\">QGIS</span>\n  </div>\n</div>\n\n</aside>\n\n<main class=\"main-content\">\n```\n\n```{r block-eu}\n#| echo: false\nrender_lang_block(cv, \"eu\", active = TRUE)\n```\n\n```{r block-en}\n#| echo: false\nrender_lang_block(cv, \"en\")\n```\n\n```{r block-es}\n#| echo: false\nrender_lang_block(cv, \"es\")\n```\n\n```{=html}\n<footer class=\"site-footer\">\n  <span>© 2026 Ainhoa Vega-Bayo · UPV/EHU</span>\n  <span>Built with Quarto &amp; R · GitHub Pages</span>\n</footer>\n</main>\n</div>\n\n<script>\nconst LANGS = ['eu', 'en', 'es'];\nfunction setLang(lang) {\n  LANGS.forEach(l => {\n    document.getElementById('block-' + l)?.classList.toggle('active', l === lang);\n    document.getElementById('sidebar-' + l)?.classList.toggle('active', l === lang);\n    document.getElementById('sl-int-' + l)?.classList.toggle('active', l === lang);\n    document.getElementById('btn-' + l)?.classList.toggle('active', l === lang);\n  });\n  localStorage.setItem('cv-lang', lang);\n}\n(function() {\n  const saved = localStorage.getItem('cv-lang');\n  if (saved && LANGS.includes(saved)) { setLang(saved); return; }\n  const nav = (navigator.language || '').toLowerCase();\n  if (nav.startsWith('eu')) setLang('eu');\n  else if (nav.startsWith('es')) setLang('es');\n  else setLang('eu');\n})();\n</script>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":